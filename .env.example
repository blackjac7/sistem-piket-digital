# Produksi Zeabur: salin PostgreSQL Connection String dari dashboard Zeabur.
DB_CONNECTION=postgresql://username:password@host.zeabur.app:5432/database
# Testing lokal (aktifkan baris ini sebagai pengganti DB_CONNECTION di atas):
# DB_CONNECTION=postgresql://postgres:postgres@127.0.0.1:5433/smp_ip_yakin
SESSION_COOKIE_NAME=smp_ip_yakin_session
WEBAUTHN_RP_NAME=SMP IP YAKIN
# Produksi: domain aplikasi tanpa protokol, misalnya piket.smpipyakin.sch.id
WEBAUTHN_RP_ID=localhost
# Produksi: URL HTTPS aplikasi, misalnya https://piket.smpipyakin.sch.id
WEBAUTHN_ORIGIN=http://localhost:3000
